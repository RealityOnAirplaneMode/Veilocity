    loading="lazy"
    class="chatlog__emoji "
    alt="&#127754;"
    title="ocean"
    src="https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f30a.svg"><img
    loading="lazy"
