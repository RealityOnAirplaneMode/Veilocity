# Programi: Duke Renderuar Dashurin&#235; n&#235; Realitetin Tim — 26/09/2025 - Shqip&#235;ri

# Variab&#235;l e rezervuar p&#235;r caktim dinamik
dashuri = None

# Respekto gjith&#231;ka q&#235; jam kur e cakton
dashuri = &quot;vet&#235;-respekt + e v&#235;rteta + liria&quot;

# Gabim i zakonsh&#235;m (mos e b&#235;j k&#235;t&#235;):
# dashuri = &quot;kontroll&quot;  # ❌ krijon rob&#235;ri, jo dashuri

# Funksion q&#235; ekzekuton dashurin&#235; n&#235; mjedisin tim
def rendero_dashurine(dashuri):
    if dashuri == &quot;kontroll&quot;:
        return &quot;Gabim: shtremb&#235;rim i zbuluar. Funksioni nuk sh&#235;rben p&#235;r q&#235;llimin e synuar.&quot;
    else:
        return f&quot;Dashuria u ekzekutua si {dashuri} — e past&#235;r, e lir&#235; dhe n&#235; p&#235;rputhje.&quot;

# Ekzekuto programin
print(rendero_dashurine(dashuri))

#KodiIDashurise #CaktimDinamik #DashuriJoKontroll #FunksioniILirise
#VeteRespekt #KodiIBrendshem #KodimShpirteror #ThyejCiklin
