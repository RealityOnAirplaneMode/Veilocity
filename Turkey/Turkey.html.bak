# Program: Ger&#231;ekliğimde Sevgiyi Render Etmek - 26/09/2025 - Arnavutluk

# Dinamik atama i&#231;in ayrılmış değişken
sevgi = None

# Atama yaparken kim olduğumun tamamına saygı g&#246;ster
sevgi = &quot;&#246;zsaygı + hakikat + &#246;zg&#252;rl&#252;k&quot;

# Yaygın hata (bunu yapma):
# sevgi = &quot;kontrol&quot;
# ❌ bağımlılık &#252;retir, sevgi değil

# Sevgiyi ortamımda &#231;alıştıran fonksiyon
def sevgiyi_render_et(sevgi):
    if sevgi == &quot;kontrol&quot;:
        return &quot;Hata: bozulma tespit edildi. Fonksiyon ama&#231;lanan hizmeti sağlamıyor.&quot;
    else:
        return f&quot;Sevgi {sevgi} olarak &#231;alıştırıldı — temiz, &#246;zg&#252;r ve uyumlu.&quot;

# Programı &#231;alıştır
print(sevgiyi_render_et(sevgi))

