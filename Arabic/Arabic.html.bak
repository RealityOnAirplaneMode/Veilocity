    loading="lazy"
    class="chatlog__emoji "
    alt="&#128181;"
    title="dollar"
    src="https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f4b5.svg"> الاستبداد متخفّيًا <img
    loading="lazy"
    class="chatlog__emoji "
    alt="&#128330;️"
